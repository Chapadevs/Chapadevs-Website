## SCSS Architecture & Best Practices
### File Structure
```scss
// component-name.component.scss
// ==========================================

// Variables (ALWAYS USE BRAND COLORS)
$primary-green: #10b981;
$teal: #0d9488;
$light-green: #a7f3d0;
$white: #ffffff;
$dark-charcoal: #111827;
$muted-grey: #6b7280;

// Typography Variables
$font-primary: 'Code Bold', monospace;
$font-secondary: 'Coolvetica', sans-serif;

// Responsive Mixin
@mixin responsive($breakpoint) {
  @if $breakpoint == mobile {
    @media (max-width: 767px) { @content; }
  } @else if $breakpoint == tablet {
    @media (min-width: 768px) and (max-width: 1023px) { @content; }
  } @else if $breakpoint == desktop {
    @media (min-width: 1024px) { @content; }
  }
}

// Brand Element Mixins
@mixin sharp-edge {
  border-radius: 0.25rem; // Sharp edges, not rounded
}

@mixin triangle-accent($size: 8px, $color: $primary-green) {
  &::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-left: $size solid transparent;
    border-bottom: $size solid $color;
  }
}

@mixin code-symbols {
  &::before {
    content: '<';
    color: $primary-green;
    margin-right: 0.5rem;
  }
  &::after {
    content: '/>';
    color: $primary-green;
    margin-left: 0.5rem;
  }
}

@mixin geometric-pattern {
  background-image: 
    linear-gradient(45deg, $light-green 25%, transparent 25%),
    linear-gradient(-45deg, $light-green 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, $light-green 75%),
    linear-gradient(-45deg, transparent 75%, $light-green 75%);
  background-size: 20px 20px;
  background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
}

// SHOWER GLASS EFFECT - Frosted, Opaque, Grey Tone (NO SHADOWS)
@mixin shower-glass-effect {
  background: rgba(128, 128, 128, 0.4); // Increased opacity for more visible effect
  backdrop-filter: blur(25px) saturate(250%); // Increased blur and saturation for better glass effect
  -webkit-backdrop-filter: blur(25px) saturate(250%);
  border: 1px solid rgba(255, 255, 255, 0.5); // More visible border
  position: relative; // Ensure proper stacking context
  z-index: 5; // Higher than floating shapes
  
  // Additional frosted layer for more opacity
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(200, 200, 200, 0.2); // Increased opacity
    backdrop-filter: blur(10px); // Increased blur
    -webkit-backdrop-filter: blur(10px);
    border-radius: inherit;
    z-index: -1;
  }
}
```

### Component Design Rules

### Buttons
```scss
@mixin btn--primary {
  background: $primary-green;
  color: $white;
  font-family: $font-primary;
  font-weight: 600;
  padding: 0.75rem 1.5rem;
  border: none;
  @include sharp-edge;
  @include code-symbols;
  transition: all 0.3s ease-in-out;
  
  &:hover {
    background: $teal;
    transform: translateY(-2px);
  }
}

@mixin btn--secondary {
  background: transparent;
  color: $primary-green;
  font-family: $font-primary;
  font-weight: 600;
  padding: 0.75rem 1.5rem;
  border: 2px solid $primary-green;
  @include sharp-edge;
  transition: all 0.3s ease-in-out;
  
  &:hover {
    background: $primary-green;
    color: $white;
  }
}
```

### Titles - WEBSITE TITLE DESIGN RULE
```scss
// TITLE DESIGN RULE: Based on Hero component pattern
// All website titles follow this structure and styling approach

@mixin title--hero {
  font-family: $font-primary;
  font-weight: 300; // Light/Medium for hero
  font-size: 3rem;
  color: $dark-charcoal;
  line-height: 1.2;
  @include triangle-accent(12px, $primary-green);
  
  @include responsive(mobile) {
    font-size: 2rem;
  }
}

@mixin title--section {
  font-family: $font-primary;
  font-weight: 700; // Bold for sections
  font-size: 2.5rem;
  color: $dark-charcoal;
  line-height: 1.3;
  @include triangle-accent(8px, $primary-green);
  
  @include responsive(mobile) {
    font-size: 2rem;
  }
}

// TITLE DESIGN RULE: Two-line structure with brand colors
// First line: "YOUR" in dark charcoal, "Digital Vision," in green
// Second line: "OUR CODE" in green with subtle glow effect
@mixin title--brand-split {
  font-family: $font-primary;
  font-weight: 700;
  text-align: center;
  line-height: 1.1;
  
  .title-line-1 {
    font-size: 3.5rem;
    margin-bottom: 0.5rem;
    
    .dark-text {
      color: $dark-charcoal;
    }
    
    .green-text {
      color: $primary-green;
      text-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
    }
  }
  
  .title-line-2 {
    font-size: 3.5rem;
    color: $primary-green;
    text-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
  }
  
  @include responsive(mobile) {
    .title-line-1, .title-line-2 {
      font-size: 2.5rem;
    }
  }
  
  @include responsive(tablet) {
    .title-line-1, .title-line-2 {
      font-size: 3rem;
    }
  }
  
  @include responsive(desktop) {
    .title-line-1, .title-line-2 {
      font-size: 4rem;
    }
  }
}

// TITLE DESIGN RULE: Standard component titles
@mixin title--component {
  font-family: $font-primary;
  font-weight: 700;
  font-size: 2rem;
  color: $dark-charcoal;
  line-height: 1.3;
  margin-bottom: 1rem;
  position: relative;
  
  &::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 60px;
    height: 3px;
    background: $primary-green;
  }
  
  @include responsive(mobile) {
    font-size: 1.75rem;
  }
}

// TITLE DESIGN RULE: Subtitle styling
@mixin title--subtitle {
  font-family: $font-secondary;
  font-weight: 400;
  font-size: 1.25rem;
  color: $muted-grey;
  line-height: 1.6;
  margin-bottom: 2rem;
  
  .highlight {
    color: $primary-green;
    font-weight: 600;
  }
  
  @include responsive(mobile) {
    font-size: 1.125rem;
  }
}
```

